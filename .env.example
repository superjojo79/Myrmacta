# Config minimale pour le dev local. Copier en .env :
#   cp .env.example .env
#
# `docker compose` (et `podman compose`) charge ce fichier automatiquement.
# Le backend Spring Boot (./mvnw spring-boot:run, lancé sur l'hôte, pas en conteneur) ne lit
# PAS .env nativement : avant de le démarrer, charger les variables dans le shell, par ex. :
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# --- PostgreSQL (docker-compose.yml + backend) ---
DB_NAME=flowforge
# Superuser du conteneur Postgres (bootstrap / init SQL). L'app n'utilise pas ce rôle.
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge

# Rôle applicatif limité au schéma tenant_dev (D-41)
DB_USERNAME=flowforge_tenant_dev
DB_PASSWORD=flowforge
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/flowforge

# --- Tenant (une instance backend = un tenant, cf. décision n°13) ---
# Doit correspondre au schéma créé par docker/postgres/init/01-init-tenant-schema.sql
# Profil Spring : local autorise les secrets de démo (D-43). Hors local/test, le boot refuse
# DB_PASSWORD=flowforge et le HMAC M2M.
SPRING_PROFILES_ACTIVE=local

# Actuator (scrape Prometheus) — bind localhost, port ≠ Keycloak 8081 (D-42)
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8090

# --- Cookie de session ---
# false en dev local sur http://localhost (pas de HTTPS) : sans ça, le navigateur rejette le
# cookie de session « Secure » et /api/auth/me boucle sans jamais authentifier. Repasser à
# true (ou l'omettre) dès que l'app tourne derrière HTTPS.
APP_SECURITY_COOKIE_SECURE=false

# --- Keycloak (docker-compose.yml + backend) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
OIDC_CLIENT_ID=mon-app
OIDC_CLIENT_SECRET=dev-secret-change-me
OIDC_ISSUER_URI=http://localhost:8081/realms/flowforge

# --- Machine-to-machine (/api/m2m/**, connecteurs + serveur MCP) ---
# M2M_JWT_SECRET : HMAC HS256 de test, dev/test uniquement — refusé au démarrage hors profils
# local/test (D-43). Laisser vide pour désactiver le canal M2M en local (défaut).
# OAUTH2_ISSUER_URI : émetteur JWT réel (Keycloak), seul mécanisme valide en production —
# jamais les deux en même temps, voir GETTING-STARTED.md §12 et DEPLOIEMENT.md §7.
M2M_JWT_SECRET=
OAUTH2_ISSUER_URI=

# --- Email (canal de notification SMTP) ---
# Aucun serveur SMTP n'est fourni par docker-compose.yml : sans configuration, les envois
# échouent silencieusement et finissent en DEAD dans notification_outbox (voir
# GETTING-STARTED.md §6). Laisser vide en dev si le canal email n'est pas testé.
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- Stockage documents : "filesystem" (par défaut, zéro conteneur requis) ou "s3" ---
APP_STORAGE_TYPE=filesystem
APP_STORAGE_FS_ROOT=./data/documents

# Ci-dessous : uniquement si APP_STORAGE_TYPE=s3. Le backend S3 est interchangeable — MinIO,
# RustFS, SeaweedFS ou tout autre stockage compatible S3 (y compris un vrai bucket AWS S3) —
# seuls le endpoint/région/identifiants changent, jamais le code applicatif. `APP_STORAGE_S3_*`
# est le seul point de config : ne jamais coder un client MinIO/RustFS/SeaweedFS spécifique.
#
# Démarrer le backend choisi avec `docker compose --profile <minio|rustfs|seaweedfs> up -d`
# (un seul profil à la fois — même bucket, même credentials, seul le endpoint diffère) :
#
#   MinIO      -> APP_STORAGE_S3_ENDPOINT=http://localhost:9000
#   RustFS     -> APP_STORAGE_S3_ENDPOINT=http://localhost:9000
#   SeaweedFS  -> APP_STORAGE_S3_ENDPOINT=http://localhost:8333  (pas d'auth réelle en dev local)
#   AWS S3 réel -> laisser APP_STORAGE_S3_ENDPOINT vide, renseigner la vraie région/clés
APP_STORAGE_S3_BUCKET=flowforge-documents
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_ENDPOINT=http://localhost:9000
APP_STORAGE_S3_ACCESS_KEY=flowforge
APP_STORAGE_S3_SECRET_KEY=flowforge123

# Utilisées par docker-compose.yml pour provisionner le bucket (services *-init) — garder
# alignées avec APP_STORAGE_S3_ACCESS_KEY / APP_STORAGE_S3_SECRET_KEY / APP_STORAGE_S3_BUCKET
# ci-dessus quand APP_STORAGE_TYPE=s3.
S3_ACCESS_KEY=flowforge
S3_SECRET_KEY=flowforge123
S3_BUCKET_NAME=flowforge-documents
