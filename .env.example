# Gabarit d'un environnement réel (staging, production) — une instance = un tenant.
# Pour le dev local, utiliser .env.local.example (cp .env.local.example .env).
#
# Volontairement incomplet : les secrets sont vides et le démarrage est REFUSÉ tant qu'ils ne
# sont pas renseignés (fail-fast D-43, TODO §64, §82, §95). Chaque variable est détaillée dans
# docs/guides/DEPLOIEMENT.md §2 ; les variables optionnelles (connecteurs, assistant, portail, signature…)
# sont documentées dans .env.local.example.

# --- Environnement : seul interrupteur « mode dev » (TODO §95) ---
# production (défaut, le plus strict) | staging. Jamais local hors poste de développement.
APP_ENVIRONMENT=production
# Un profil dédié, jamais local (refusé hors APP_ENVIRONMENT=local) ni test (refusé en production).
# La boucle locale (webhook http://localhost, IMAP localhost / PLAIN) n'est ouverte qu'en APP_ENVIRONMENT=local (TODO §132).
SPRING_PROFILES_ACTIVE=prod

# --- Tenant (décisions n° 13 et 14, docs/guides/DEPLOIEMENT.md §3-§4) ---
APP_TENANT_ID=

# --- PostgreSQL : rôle applicatif du tenant (scripts/provision-tenant.sh) ---
DB_URL=jdbc:postgresql://db.example.internal:5432/myrmacta
DB_USERNAME=
# Obligatoire, hors denylist (myrmacta, flowforge, postgres, admin, password). flowforge-legacy
DB_PASSWORD=

# --- Chiffrement des secrets de connecteurs (obligatoire) ---
APP_CONNECTOR_MASTER_KEY=

# --- OIDC (Keycloak réel, docs/guides/DEPLOIEMENT.md §5) ---
OIDC_ISSUER_URI=https://auth.example.org/realms/myrmacta
OIDC_CLIENT_ID=
# Obligatoire.
OIDC_CLIENT_SECRET=

# --- Machine-to-machine (docs/guides/DEPLOIEMENT.md §7) : jamais M2M_JWT_SECRET (refusé au démarrage) ---
OAUTH2_ISSUER_URI=
# Obligatoire dès que le canal M2M est actif (APP_ENVIRONMENT ≠ local).
M2M_TRUSTED_CLIENT_IDS=

# --- Antivirus des pièces jointes (docs/guides/DEPLOIEMENT.md § ClamAV) ---
# noop est refusé en production sauf acquittement explicite ci-dessous.
APP_DOSSIER_ATTACHMENT_SCAN_TYPE=clamav
APP_DOSSIER_ATTACHMENT_SCAN_CLAMAV_HOST=
APP_DOSSIER_ATTACHMENT_SCAN_CLAMAV_PORT=3310
# APP_DOSSIER_ATTACHMENT_SCAN_NOOP_ACKNOWLEDGED=false

# --- Stockage des documents ---
APP_STORAGE_TYPE=s3
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=

# --- E-mail sortant ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- Actuator : bind localhost (D-42) ---
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_PORT=8090

# Groupes d'utilisateurs (TODO §114) : claim du jeton qui porte les groupes repris par Admin → Groupes.
# Keycloak : mapper « Group Membership » (nom de claim groups). Entra ID : claim groups (identifiants GUID des groupes).
# APP_SECURITY_OIDC_GROUPS_CLAIM=groups

# Échéances de dossier (TODO §115) : intervalle du job de rappel et d'escalade, en ms (défaut 15 minutes).
# APP_DEADLINES_SCAN_INTERVAL_MS=900000
