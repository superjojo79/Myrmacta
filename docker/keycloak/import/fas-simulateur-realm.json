{
  "realm": "fas-simulateur",
  "displayName": "Simulateur FAS / itsme (dev et recette, TODO §104)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
