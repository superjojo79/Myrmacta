      "attributes": {
        "use.jwks.url": "true",
        "jwks.url": "http://localhost:${KEYCLOAK_PORT:8081}/realms/flowforge/protocol/openid-connect/certs",
        "token.endpoint.auth.signing.alg": "RS256",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [],
