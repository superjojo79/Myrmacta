{
  "realm": "flowforge",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "mon-app",
      "name": "Myrmacta BFF (dev local)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles (ID token)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "TENANT_ADMIN"
      },
      {
        "name": "WORKFLOW_ADMIN"
      },
      {
        "name": "DOSSIER_MANAGER"
      },
      {
        "name": "DOSSIER_VIEWER"
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@flowforge.local",
      "attributes": {
        "tenant_id": [
          "tenant_dev"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TENANT_ADMIN",
        "WORKFLOW_ADMIN"
      ]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Manager",
      "lastName": "User",
      "email": "manager@flowforge.local",
      "attributes": {
        "tenant_id": [
          "tenant_dev"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DOSSIER_MANAGER"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "User",
      "email": "viewer@flowforge.local",
      "attributes": {
        "tenant_id": [
          "tenant_dev"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DOSSIER_VIEWER"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant Myrmacta\",\"validations\":{\"length\":{\"max\":64}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "fas",
      "displayName": "eID, itsme et autres (FAS simulé)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "keycloak-flowforge",
        "clientAuthMethod": "private_key_jwt",
        "clientAssertionSigningAlg": "RS256",
        "authorizationUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur/protocol/openid-connect/token",
        "userInfoUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur/protocol/openid-connect/userinfo",
        "jwksUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur/protocol/openid-connect/certs",
        "logoutUrl": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur/protocol/openid-connect/logout",
        "issuer": "http://localhost:${KEYCLOAK_PORT:8081}/realms/fas-simulateur",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid",
        "syncMode": "IMPORT",
        "backchannelSupported": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "prénom",
      "identityProviderAlias": "fas",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "givenName",
        "user.attribute": "firstName",
        "syncMode": "IMPORT"
      }
    },
    {
      "name": "nom",
      "identityProviderAlias": "fas",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "surname",
        "user.attribute": "lastName",
        "syncMode": "IMPORT"
      }
    },
    {
      "name": "e-mail",
      "identityProviderAlias": "fas",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "mail",
        "user.attribute": "email",
        "syncMode": "IMPORT"
      }
    }
  ]
}
