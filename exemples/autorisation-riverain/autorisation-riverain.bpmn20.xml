<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://flowforge/exemples">
  <!-- Variante avec portail. Généré par generer-bpmn.py : modifier le script plutôt que ce fichier. -->
  <process id="autorisationRiverain" name="Autorisation riverain (véhicule)" isExecutable="true">
    <startEvent id="debut" name="Demande introduite"/>
    <serviceTask id="prepEmail" name="Adresse de notification connue ?" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='$exists(variables.notificationTo) and $contains($string(variables.notificationTo), "@")' flowable:formulaResult="emailConnu"/>
    <serviceTask id="statutEnInstruction" name="Statut : en instruction" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_INSTRUCTION"/>
    <userTask id="instruction" name="Instruire la demande" flowable:formKey="user-question:instruction-autorisation-riverain"><documentation>Vérifier la demande et l'absence d'autre demande pour le même véhicule (recherche sur « Clé d'unicité du véhicule »), puis autoriser, refuser ou demander des informations complémentaires. Sans décision dans les 30 jours, l'autorisation est accordée automatiquement.</documentation></userTask>
    <boundaryEvent id="delaiInstruction" name="30 jours écoulés" attachedToRef="instruction" cancelActivity="true"><timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition></boundaryEvent>
    <exclusiveGateway id="aiguillageDecision" name="Décision ?" default="flow_aiguillageDecision_statutEnAttente"/>
    <serviceTask id="issueTacite" name="Issue : autorisée tacitement" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='"AUTORISEE_TACITEMENT"' flowable:formulaResult="issueDecision"/>
    <serviceTask id="issueAutorisee" name="Issue : autorisée" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='"AUTORISEE"' flowable:formulaResult="issueDecision"/>
    <serviceTask id="issueRefusee" name="Issue : refusée" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='"REFUSEE"' flowable:formulaResult="issueDecision"/>
    <serviceTask id="statutEnAttente" name="Statut : en attente d'informations" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_ATTENTE_INFOS"/>
    <serviceTask id="dossierSuspendu" name="Dossier suspendu" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="SUSPENDU"/>
    <userTask id="complement" name="Compléments du demandeur (portail)" flowable:formKey="user-question:complement-autorisation-riverain" flowable:portalRecipient="dossierField:email" flowable:portalLinkTtlDays="30"><documentation>Le gestionnaire a besoin d'informations complémentaires pour instruire votre demande d'autorisation riverain. Répondez ci-dessous et joignez les pièces utiles (certificat d'immatriculation, preuve de domicile). Sans réponse dans les 30 jours, la demande sera refusée.</documentation></userTask>
    <boundaryEvent id="delaiComplement" name="30 jours sans réponse" attachedToRef="complement" cancelActivity="true"><timerEventDefinition><timeDuration>P30D</timeDuration></timerEventDefinition></boundaryEvent>
    <serviceTask id="dossierRepris" name="Dossier repris" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="EN_COURS"/>
    <serviceTask id="issueSansReponse" name="Issue : refusée sans réponse" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='"REFUSEE_SANS_REPONSE"' flowable:formulaResult="issueDecision"/>
    <exclusiveGateway id="decisionPrise"/>
    <serviceTask id="prepReference" name="Référence du dossier" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="dossier.reference" flowable:formulaResult="referenceDossier"/>
    <serviceTask id="prepDate" name="Date de décision" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="$substring(now, 0, 10)" flowable:formulaResult="dateDecision"/>
    <serviceTask id="prepTelephone" name="Téléphone (défaut)" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='$exists(dossier.fields.telephone) and $length($trim($string(dossier.fields.telephone))) &gt; 0 ? dossier.fields.telephone : "Non communiqué"' flowable:formulaResult="docTelephone"/>
    <serviceTask id="prepPieces" name="Pièces jointes à la demande" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="&quot;Certificat d'immatriculation : &quot; &amp; ($exists(dossier.fields.certificatImmatriculation) ? &quot;fourni&quot; : &quot;non fourni&quot;) &amp; &quot; — preuve de domicile : &quot; &amp; ($exists(dossier.fields.preuveDomicile) ? &quot;fournie&quot; : &quot;non fournie&quot;)" flowable:formulaResult="docPieces"/>
    <serviceTask id="prepComplements" name="Compléments (défaut)" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='$exists(variables.reponseComplement) ? variables.reponseComplement : "Aucun"' flowable:formulaResult="docComplements"/>
    <serviceTask id="prepMotivation" name="Motivation" flowable:delegateExpression="${businessExpressionTask}" flowable:formula='variables.issueDecision = "AUTORISEE_TACITEMENT" ? "Absence de décision dans le délai de 30 jours" : variables.issueDecision = "REFUSEE_SANS_REPONSE" ? "Informations complémentaires non fournies dans le délai de 30 jours" : ($exists(variables.motivation) ? variables.motivation : "-")' flowable:formulaResult="docMotivation"/>
    <serviceTask id="enregistrerDecision" name="Enregistrer la décision au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="decision = variables.issueDecision&#10;dateDecision = variables.dateDecision&#10;motifDecision = variables.docMotivation"/>
    <serviceTask id="genererDecision" name="Générer le document de décision" flowable:delegateExpression="${documentGenerationTask}" flowable:documentType="decision-autorisation-riverain"/>
    <serviceTask id="joindreDecision" name="Joindre le document au dossier" flowable:delegateExpression="${attachGeneratedDocumentTask}"/>
    <exclusiveGateway id="aiguillageEmail" name="E-mail ?" default="flow_aiguillageEmail_mailEnvoye"/>
    <exclusiveGateway id="aiguillageMail" name="Accordée ?" default="flow_aiguillageMail_mailRefus"/>
    <serviceTask id="mailAutorisation" name="E-mail : autorisation accordée" flowable:delegateExpression="${notificationDispatchTask}" flowable:notificationChannels="EMAIL" flowable:notificationSubject="Votre demande d'autorisation riverain est accordée" flowable:notificationBody="Bonjour,&#10;&#10;Votre demande d'autorisation riverain est accordée.&#10;&#10;Le document de décision, qui reprend l'ensemble des informations de votre demande, vous est transmis séparément par nos services.&#10;&#10;Cordialement,&#10;Le service des autorisations riverains"/>
    <serviceTask id="mailRefus" name="E-mail : autorisation refusée" flowable:delegateExpression="${notificationDispatchTask}" flowable:notificationChannels="EMAIL" flowable:notificationSubject="Votre demande d'autorisation riverain est refusée" flowable:notificationBody="Bonjour,&#10;&#10;Votre demande d'autorisation riverain est refusée. Les motifs figurent dans le document de décision.&#10;&#10;Le document de décision, qui reprend l'ensemble des informations de votre demande, vous est transmis séparément par nos services.&#10;&#10;Cordialement,&#10;Le service des autorisations riverains"/>
    <exclusiveGateway id="mailEnvoye"/>
    <userTask id="transmission" name="Transmettre le document de décision" flowable:formKey="user-question:transmission-decision-riverain"><documentation>Télécharger le PDF de décision depuis les éléments du dossier et l'envoyer au demandeur (FlowForge ne joint pas de fichier à ses e-mails).</documentation></userTask>
    <exclusiveGateway id="aiguillageStatut" name="Issue ?" default="flow_aiguillageStatut_statutRefusee"/>
    <serviceTask id="statutAutorisee" name="Statut : autorisée" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="AUTORISEE"/>
    <serviceTask id="statutTacite" name="Statut : autorisée tacitement" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="AUTORISEE_TACITEMENT"/>
    <serviceTask id="statutRefusee" name="Statut : refusée" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="REFUSEE"/>
    <exclusiveGateway id="statutPose"/>
    <serviceTask id="clotureDossier" name="Clôturer le dossier" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="CLOTURE"/>
    <endEvent id="fin" name="Demande traitée"/>
    <sequenceFlow id="flow_dossierSuspendu_complement" sourceRef="dossierSuspendu" targetRef="complement"/>
    <sequenceFlow id="flow_debut_prepEmail" sourceRef="debut" targetRef="prepEmail"/>
    <sequenceFlow id="flow_prepEmail_statutEnInstruction" sourceRef="prepEmail" targetRef="statutEnInstruction"/>
    <sequenceFlow id="flow_statutEnInstruction_instruction" sourceRef="statutEnInstruction" targetRef="instruction"/>
    <sequenceFlow id="flow_instruction_aiguillageDecision" sourceRef="instruction" targetRef="aiguillageDecision"/>
    <sequenceFlow id="flow_delaiInstruction_issueTacite" sourceRef="delaiInstruction" targetRef="issueTacite"/>
    <sequenceFlow id="flow_aiguillageDecision_issueAutorisee" sourceRef="aiguillageDecision" targetRef="issueAutorisee"><conditionExpression xsi:type="tFormalExpression">${decisionAgent == 'AUTORISER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageDecision_issueRefusee" sourceRef="aiguillageDecision" targetRef="issueRefusee"><conditionExpression xsi:type="tFormalExpression">${decisionAgent == 'REFUSER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageDecision_statutEnAttente" sourceRef="aiguillageDecision" targetRef="statutEnAttente"/>
    <sequenceFlow id="flow_statutEnAttente_dossierSuspendu" sourceRef="statutEnAttente" targetRef="dossierSuspendu"/>
    <sequenceFlow id="flow_complement_dossierRepris" sourceRef="complement" targetRef="dossierRepris"/>
    <sequenceFlow id="flow_dossierRepris_statutEnInstruction" sourceRef="dossierRepris" targetRef="statutEnInstruction"/>
    <sequenceFlow id="flow_delaiComplement_issueSansReponse" sourceRef="delaiComplement" targetRef="issueSansReponse"/>
    <sequenceFlow id="flow_issueTacite_decisionPrise" sourceRef="issueTacite" targetRef="decisionPrise"/>
    <sequenceFlow id="flow_issueAutorisee_decisionPrise" sourceRef="issueAutorisee" targetRef="decisionPrise"/>
    <sequenceFlow id="flow_issueRefusee_decisionPrise" sourceRef="issueRefusee" targetRef="decisionPrise"/>
    <sequenceFlow id="flow_issueSansReponse_decisionPrise" sourceRef="issueSansReponse" targetRef="decisionPrise"/>
    <sequenceFlow id="flow_decisionPrise_prepReference" sourceRef="decisionPrise" targetRef="prepReference"/>
    <sequenceFlow id="flow_prepReference_prepDate" sourceRef="prepReference" targetRef="prepDate"/>
    <sequenceFlow id="flow_prepDate_prepTelephone" sourceRef="prepDate" targetRef="prepTelephone"/>
    <sequenceFlow id="flow_prepTelephone_prepPieces" sourceRef="prepTelephone" targetRef="prepPieces"/>
    <sequenceFlow id="flow_prepPieces_prepComplements" sourceRef="prepPieces" targetRef="prepComplements"/>
    <sequenceFlow id="flow_prepComplements_prepMotivation" sourceRef="prepComplements" targetRef="prepMotivation"/>
    <sequenceFlow id="flow_prepMotivation_enregistrerDecision" sourceRef="prepMotivation" targetRef="enregistrerDecision"/>
    <sequenceFlow id="flow_enregistrerDecision_genererDecision" sourceRef="enregistrerDecision" targetRef="genererDecision"/>
    <sequenceFlow id="flow_genererDecision_joindreDecision" sourceRef="genererDecision" targetRef="joindreDecision"/>
    <sequenceFlow id="flow_joindreDecision_aiguillageEmail" sourceRef="joindreDecision" targetRef="aiguillageEmail"/>
    <sequenceFlow id="flow_aiguillageEmail_aiguillageMail" sourceRef="aiguillageEmail" targetRef="aiguillageMail"><conditionExpression xsi:type="tFormalExpression">${emailConnu == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageEmail_mailEnvoye" sourceRef="aiguillageEmail" targetRef="mailEnvoye"/>
    <sequenceFlow id="flow_aiguillageMail_mailAutorisation" sourceRef="aiguillageMail" targetRef="mailAutorisation"><conditionExpression xsi:type="tFormalExpression">${issueDecision == 'AUTORISEE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageMail_mailAutorisation_tacite" sourceRef="aiguillageMail" targetRef="mailAutorisation"><conditionExpression xsi:type="tFormalExpression">${issueDecision == 'AUTORISEE_TACITEMENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageMail_mailRefus" sourceRef="aiguillageMail" targetRef="mailRefus"/>
    <sequenceFlow id="flow_mailAutorisation_mailEnvoye" sourceRef="mailAutorisation" targetRef="mailEnvoye"/>
    <sequenceFlow id="flow_mailRefus_mailEnvoye" sourceRef="mailRefus" targetRef="mailEnvoye"/>
    <sequenceFlow id="flow_mailEnvoye_transmission" sourceRef="mailEnvoye" targetRef="transmission"/>
    <sequenceFlow id="flow_transmission_aiguillageStatut" sourceRef="transmission" targetRef="aiguillageStatut"/>
    <sequenceFlow id="flow_aiguillageStatut_statutAutorisee" sourceRef="aiguillageStatut" targetRef="statutAutorisee"><conditionExpression xsi:type="tFormalExpression">${issueDecision == 'AUTORISEE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageStatut_statutTacite" sourceRef="aiguillageStatut" targetRef="statutTacite"><conditionExpression xsi:type="tFormalExpression">${issueDecision == 'AUTORISEE_TACITEMENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageStatut_statutRefusee" sourceRef="aiguillageStatut" targetRef="statutRefusee"/>
    <sequenceFlow id="flow_statutAutorisee_statutPose" sourceRef="statutAutorisee" targetRef="statutPose"/>
    <sequenceFlow id="flow_statutTacite_statutPose" sourceRef="statutTacite" targetRef="statutPose"/>
    <sequenceFlow id="flow_statutRefusee_statutPose" sourceRef="statutRefusee" targetRef="statutPose"/>
    <sequenceFlow id="flow_statutPose_clotureDossier" sourceRef="statutPose" targetRef="clotureDossier"/>
    <sequenceFlow id="flow_clotureDossier_fin" sourceRef="clotureDossier" targetRef="fin"/>
  </process>
