<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://myrmacta/exemples">
  <!-- Workflow « réponse » (§113 D-MAILROOM-REPLY-WORKFLOW, mode DOSSIER_ENFANT) : démarre dans un dossier enfant de la facture
       à chaque réponse rattachée au fil, avec les variables courrierId et courrierReference. -->
  <process id="traiterReponse" name="Traiter la réponse d'un fournisseur" isExecutable="true">
    <startEvent id="debut" name="Réponse reçue"/>
    <userTask id="traiterReponseTache" name="Traiter la réponse"><documentation>Le courrier (variable courrierReference) répond au fil de la facture parente ; ses pièces sont dans la facture. Décider de la suite, puis terminer la tâche.</documentation></userTask>
    <serviceTask id="statutTraitee" name="Statut : traitée" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="TRAITEE"/>
    <serviceTask id="clotureReponse" name="Clôturer la réponse" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="CLOTURE"/>
    <endEvent id="fin" name="Réponse traitée"/>
    <sequenceFlow id="flow_debut_traiter" sourceRef="debut" targetRef="traiterReponseTache"/>
    <sequenceFlow id="flow_traiter_statut" sourceRef="traiterReponseTache" targetRef="statutTraitee"/>
    <sequenceFlow id="flow_statut_cloture" sourceRef="statutTraitee" targetRef="clotureReponse"/>
    <sequenceFlow id="flow_cloture_fin" sourceRef="clotureReponse" targetRef="fin"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram_traiterReponse">
    <bpmndi:BPMNPlane id="plane_traiterReponse" bpmnElement="traiterReponse">
      <bpmndi:BPMNShape id="shape_debut" bpmnElement="debut"><omgdc:Bounds x="80" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_traiterReponseTache" bpmnElement="traiterReponseTache"><omgdc:Bounds x="170" y="100" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_statutTraitee" bpmnElement="statutTraitee"><omgdc:Bounds x="340" y="100" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_clotureReponse" bpmnElement="clotureReponse"><omgdc:Bounds x="510" y="100" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_fin" bpmnElement="fin"><omgdc:Bounds x="680" y="122" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow_debut_traiter" bpmnElement="flow_debut_traiter"><omgdi:waypoint x="116" y="140"/><omgdi:waypoint x="170" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_traiter_statut" bpmnElement="flow_traiter_statut"><omgdi:waypoint x="290" y="140"/><omgdi:waypoint x="340" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_statut_cloture" bpmnElement="flow_statut_cloture"><omgdi:waypoint x="460" y="140"/><omgdi:waypoint x="510" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_cloture_fin" bpmnElement="flow_cloture_fin"><omgdi:waypoint x="630" y="140"/><omgdi:waypoint x="680" y="140"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
