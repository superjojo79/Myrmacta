<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://myrmacta/exemples">
  <!-- Généré par generer-bpmn.py : modifier le script plutôt que ce fichier. -->
  <process id="onboardingCollaborateur" name="Arrivée d'un collaborateur" isExecutable="true">
    <startEvent id="debut" name="Arrivée encodée par les RH"/>
    <serviceTask id="statutValidation" name="Statut : en validation" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_VALIDATION"/>
    <userTask id="validationManager" name="Valider l'arrivée" flowable:formKey="user-question:validation-manager-onboarding"><documentation>Vérifier la fiche du collaborateur. APPROUVER lance la création dans le SIRH, l'IAM et l'ITSM ; CORRIGER renvoie la fiche aux RH avec votre commentaire ; REFUSER clôture la demande sans rien créer.</documentation></userTask>
    <exclusiveGateway id="decisionManager" name="Décision ?" default="flow_decisionManager_statutProvisioning"/>
    <userTask id="correction" name="Corriger la fiche" flowable:formKey="dossier-fields"><documentation>Corriger la fiche selon le commentaire du manager, puis enregistrer : la demande repart en validation.</documentation></userTask>
    <serviceTask id="statutRefuse" name="Statut : refusé" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="REFUSE"/>
    <serviceTask id="clotureRefus" name="Clôturer le dossier" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="CLOTURE"/>
    <endEvent id="finRefus" name="Arrivée refusée"/>
    <serviceTask id="statutProvisioning" name="Statut : provisioning" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_PROVISIONING"/>
    <serviceTask id="appelSirh" name="Créer la fiche SIRH" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000001" flowable:connectorRequest="{'method': 'POST', 'path': '/employees', 'headers': {'Content-Type': 'application/json'},&#10; 'body': {'firstName': dossier.fields.prenom, 'lastName': dossier.fields.nom,&#10;          'personalEmail': dossier.fields.emailPersonnel, 'jobTitle': dossier.fields.fonction,&#10;          'department': dossier.fields.departement, 'startDate': dossier.fields.dateArrivee,&#10;          'managerLogin': dossier.fields.managerLogin, 'externalReference': dossier.reference}}"/>
    <serviceTask id="controleSirh" name="Contrôle : créer la fiche sirh" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="connectorResult.status &gt;= 200 and connectorResult.status &lt; 300" flowable:formulaResult="appelOk"/>
    <exclusiveGateway id="resultatSirh" name="Réussi ?" default="flow_resultatSirh_echecSirh"/>
    <serviceTask id="echecSirh" name="Échec : SIRH" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="'SIRH'" flowable:formulaResult="etapeEnEchec"/>
    <serviceTask id="enregistrerSirh" name="Enregistrer la réponse au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="matriculeSirh = connectorResult.json.id"/>
    <serviceTask id="appelIam" name="Créer le compte IAM" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000002" flowable:connectorRequest="{'method': 'POST', 'path': '/users', 'headers': {'Content-Type': 'application/json'},&#10; 'body': {'username': $replace($lowercase($substring(dossier.fields.prenom, 0, 1) &amp; dossier.fields.nom), ' ', ''),&#10;          'firstName': dossier.fields.prenom, 'lastName': dossier.fields.nom,&#10;          'employeeNumber': dossier.fields.matriculeSirh, 'enabled': false,&#10;          'attributes': {'department': dossier.fields.departement, 'manager': dossier.fields.managerLogin}}}"/>
    <serviceTask id="controleIam" name="Contrôle : créer le compte iam" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="connectorResult.status &gt;= 200 and connectorResult.status &lt; 300" flowable:formulaResult="appelOk"/>
    <exclusiveGateway id="resultatIam" name="Réussi ?" default="flow_resultatIam_echecIam"/>
    <serviceTask id="echecIam" name="Échec : IAM" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="'IAM'" flowable:formulaResult="etapeEnEchec"/>
    <serviceTask id="enregistrerIam" name="Enregistrer la réponse au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="identifiantIam = connectorResult.json.id&#10;loginIam = connectorResult.json.username"/>
    <serviceTask id="besoinValidationIt" name="Profil sensible ?" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="dossier.fields.profilPoste != 'STANDARD'" flowable:formulaResult="validationItRequise"/>
    <exclusiveGateway id="aiguillageIt" name="Validation IT ?" default="flow_aiguillageIt_accesDecides"/>
    <userTask id="validationAcces" name="Valider les accès" flowable:formKey="user-question:validation-acces-onboarding"><documentation>Le profil de poste demande des accès étendus. ETENDU ajoute le compte au groupe du profil dans l'IAM ; STANDARD le laisse dans les groupes par défaut.</documentation></userTask>
    <exclusiveGateway id="niveauAcces" name="Niveau ?" default="flow_niveauAcces_accesDecides"/>
    <serviceTask id="appelGroupe" name="Ajouter au groupe IAM" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000002" flowable:connectorRequest="{'method': 'PUT', 'path': '/users/{id}/groups/{groupe}',&#10; 'pathParams': {'id': dossier.fields.identifiantIam,&#10;                'groupe': dossier.fields.profilPoste = 'DIRECTION' ? 'direction' : 'developpeurs'}}"/>
    <serviceTask id="controleGroupe" name="Contrôle : ajouter au groupe iam" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="connectorResult.status &gt;= 200 and connectorResult.status &lt; 300" flowable:formulaResult="appelOk"/>
    <exclusiveGateway id="resultatGroupe" name="Réussi ?" default="flow_resultatGroupe_echecGroupe"/>
    <serviceTask id="echecGroupe" name="Échec : GROUPE" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="'GROUPE'" flowable:formulaResult="etapeEnEchec"/>
    <serviceTask id="enregistrerGroupe" name="Enregistrer la réponse au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="accesEtendus = true"/>
    <exclusiveGateway id="accesDecides"/>
    <serviceTask id="appelTicket" name="Commander le matériel (ITSM)" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000003" flowable:connectorRequest="{'method': 'POST', 'path': '/tickets', 'headers': {'Content-Type': 'application/json'},&#10; 'body': {'category': 'HARDWARE', 'profile': dossier.fields.profilPoste,&#10;          'title': 'Poste de travail pour ' &amp; dossier.fields.prenom &amp; ' ' &amp; dossier.fields.nom,&#10;          'dueDate': dossier.fields.dateArrivee, 'requestedFor': dossier.fields.loginIam,&#10;          'requestedBy': dossier.fields.managerLogin, 'correlationId': dossier.reference}}"/>
    <serviceTask id="controleTicket" name="Contrôle : commander le matériel (itsm)" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="connectorResult.status &gt;= 200 and connectorResult.status &lt; 300" flowable:formulaResult="appelOk"/>
    <exclusiveGateway id="resultatTicket" name="Réussi ?" default="flow_resultatTicket_echecTicket"/>
    <serviceTask id="echecTicket" name="Échec : ITSM" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="'ITSM'" flowable:formulaResult="etapeEnEchec"/>
    <serviceTask id="enregistrerTicket" name="Enregistrer la réponse au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="ticketMateriel = connectorResult.json.number"/>
    <serviceTask id="statutProvisionne" name="Statut : provisionné" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="PROVISIONNE"/>
    <serviceTask id="clotureDossier" name="Clôturer le dossier" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="CLOTURE"/>
    <endEvent id="fin" name="Collaborateur provisionné"/>
    <exclusiveGateway id="incident"/>
    <serviceTask id="noterIncident" name="Noter l'incident au dossier" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="dernierIncident = variables.etapeEnEchec &amp; ' : HTTP ' &amp; $string(connectorResult.status) &amp; ' ' &amp; $substring($string(connectorResult.body), 0, 200)"/>
    <serviceTask id="statutIncident" name="Statut : incident" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_INCIDENT"/>
    <userTask id="traiterIncident" name="Traiter l'incident technique" flowable:formKey="user-question:incident-technique-onboarding"><documentation>Un appel à une application a échoué (champ « Dernier incident technique » de la fiche). Corriger la cause côté application, puis REESSAYER ; ou ABANDONNER : ce qui a été créé dans l'IAM et le SIRH est supprimé et la demande est clôturée.</documentation></userTask>
    <exclusiveGateway id="actionIncident" name="Action ?" default="flow_actionIncident_aCompteIam"/>
    <serviceTask id="statutReprise" name="Statut : provisioning" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="EN_PROVISIONING"/>
    <exclusiveGateway id="reprise" name="Reprendre où ?" default="flow_reprise_appelTicket"/>
    <serviceTask id="aCompteIam" name="Compte IAM créé ?" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="$exists(dossier.fields.identifiantIam)" flowable:formulaResult="compteIamCree"/>
    <exclusiveGateway id="gwCompteIam" default="flow_gwCompteIam_compteIamTraite"/>
    <serviceTask id="supprimerIam" name="Supprimer le compte IAM" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000002" flowable:connectorRequest="{'method': 'DELETE', 'path': '/users/{id}', 'pathParams': {'id': dossier.fields.identifiantIam}}"/>
    <serviceTask id="journalIam" name="Journaliser" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="journalCompensation = ($exists(dossier.fields.journalCompensation) ? dossier.fields.journalCompensation &amp; ' ; ' : '') &amp; 'IAM supprimé : HTTP ' &amp; $string(connectorResult.status)"/>
    <exclusiveGateway id="compteIamTraite"/>
    <serviceTask id="aFicheSirh" name="Fiche SIRH créée ?" flowable:delegateExpression="${businessExpressionTask}" flowable:formula="$exists(dossier.fields.matriculeSirh)" flowable:formulaResult="ficheSirhCreee"/>
    <exclusiveGateway id="gwFicheSirh" default="flow_gwFicheSirh_ficheSirhTraitee"/>
    <serviceTask id="supprimerSirh" name="Supprimer la fiche SIRH" flowable:delegateExpression="${connectorServiceTask}" flowable:async="true" flowable:connectorInstanceId="00000000-0000-4000-8000-000000000001" flowable:connectorRequest="{'method': 'DELETE', 'path': '/employees/{id}', 'pathParams': {'id': dossier.fields.matriculeSirh}}"/>
    <serviceTask id="journalSirh" name="Journaliser" flowable:delegateExpression="${fieldMappingTask}" flowable:fieldMapping="journalCompensation = ($exists(dossier.fields.journalCompensation) ? dossier.fields.journalCompensation &amp; ' ; ' : '') &amp; 'SIRH supprimé : HTTP ' &amp; $string(connectorResult.status)"/>
    <exclusiveGateway id="ficheSirhTraitee"/>
    <serviceTask id="statutAnnule" name="Statut : annulé" flowable:delegateExpression="${updateWorkflowLinkStatusTask}" flowable:targetWorkflowStatus="ANNULE"/>
    <serviceTask id="clotureAnnule" name="Clôturer le dossier" flowable:delegateExpression="${updateDossierStatusTask}" flowable:targetDossierStatus="CLOTURE"/>
    <endEvent id="finAnnule" name="Arrivée abandonnée"/>
    <sequenceFlow id="flow_appelSirh_controleSirh" sourceRef="appelSirh" targetRef="controleSirh"/>
    <sequenceFlow id="flow_controleSirh_resultatSirh" sourceRef="controleSirh" targetRef="resultatSirh"/>
    <sequenceFlow id="flow_resultatSirh_echecSirh" sourceRef="resultatSirh" targetRef="echecSirh"/>
    <sequenceFlow id="flow_echecSirh_incident" sourceRef="echecSirh" targetRef="incident"/>
    <sequenceFlow id="flow_resultatSirh_enregistrerSirh" sourceRef="resultatSirh" targetRef="enregistrerSirh"><conditionExpression xsi:type="tFormalExpression">${appelOk == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_appelIam_controleIam" sourceRef="appelIam" targetRef="controleIam"/>
    <sequenceFlow id="flow_controleIam_resultatIam" sourceRef="controleIam" targetRef="resultatIam"/>
    <sequenceFlow id="flow_resultatIam_echecIam" sourceRef="resultatIam" targetRef="echecIam"/>
    <sequenceFlow id="flow_echecIam_incident" sourceRef="echecIam" targetRef="incident"/>
    <sequenceFlow id="flow_resultatIam_enregistrerIam" sourceRef="resultatIam" targetRef="enregistrerIam"><conditionExpression xsi:type="tFormalExpression">${appelOk == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_appelGroupe_controleGroupe" sourceRef="appelGroupe" targetRef="controleGroupe"/>
    <sequenceFlow id="flow_controleGroupe_resultatGroupe" sourceRef="controleGroupe" targetRef="resultatGroupe"/>
    <sequenceFlow id="flow_resultatGroupe_echecGroupe" sourceRef="resultatGroupe" targetRef="echecGroupe"/>
    <sequenceFlow id="flow_echecGroupe_incident" sourceRef="echecGroupe" targetRef="incident"/>
    <sequenceFlow id="flow_resultatGroupe_enregistrerGroupe" sourceRef="resultatGroupe" targetRef="enregistrerGroupe"><conditionExpression xsi:type="tFormalExpression">${appelOk == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_appelTicket_controleTicket" sourceRef="appelTicket" targetRef="controleTicket"/>
    <sequenceFlow id="flow_controleTicket_resultatTicket" sourceRef="controleTicket" targetRef="resultatTicket"/>
    <sequenceFlow id="flow_resultatTicket_echecTicket" sourceRef="resultatTicket" targetRef="echecTicket"/>
    <sequenceFlow id="flow_echecTicket_incident" sourceRef="echecTicket" targetRef="incident"/>
    <sequenceFlow id="flow_resultatTicket_enregistrerTicket" sourceRef="resultatTicket" targetRef="enregistrerTicket"><conditionExpression xsi:type="tFormalExpression">${appelOk == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_debut_statutValidation" sourceRef="debut" targetRef="statutValidation"/>
    <sequenceFlow id="flow_statutValidation_validationManager" sourceRef="statutValidation" targetRef="validationManager"/>
    <sequenceFlow id="flow_validationManager_decisionManager" sourceRef="validationManager" targetRef="decisionManager"/>
    <sequenceFlow id="flow_statutRefuse_clotureRefus" sourceRef="statutRefuse" targetRef="clotureRefus"/>
    <sequenceFlow id="flow_clotureRefus_finRefus" sourceRef="clotureRefus" targetRef="finRefus"/>
    <sequenceFlow id="flow_statutProvisioning_appelSirh" sourceRef="statutProvisioning" targetRef="appelSirh"/>
    <sequenceFlow id="flow_enregistrerSirh_appelIam" sourceRef="enregistrerSirh" targetRef="appelIam"/>
    <sequenceFlow id="flow_enregistrerIam_besoinValidationIt" sourceRef="enregistrerIam" targetRef="besoinValidationIt"/>
    <sequenceFlow id="flow_besoinValidationIt_aiguillageIt" sourceRef="besoinValidationIt" targetRef="aiguillageIt"/>
    <sequenceFlow id="flow_validationAcces_niveauAcces" sourceRef="validationAcces" targetRef="niveauAcces"/>
    <sequenceFlow id="flow_enregistrerGroupe_accesDecides" sourceRef="enregistrerGroupe" targetRef="accesDecides"/>
    <sequenceFlow id="flow_accesDecides_appelTicket" sourceRef="accesDecides" targetRef="appelTicket"/>
    <sequenceFlow id="flow_enregistrerTicket_statutProvisionne" sourceRef="enregistrerTicket" targetRef="statutProvisionne"/>
    <sequenceFlow id="flow_statutProvisionne_clotureDossier" sourceRef="statutProvisionne" targetRef="clotureDossier"/>
    <sequenceFlow id="flow_clotureDossier_fin" sourceRef="clotureDossier" targetRef="fin"/>
    <sequenceFlow id="flow_decisionManager_correction" sourceRef="decisionManager" targetRef="correction"><conditionExpression xsi:type="tFormalExpression">${decisionManager == 'CORRIGER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_decisionManager_statutRefuse" sourceRef="decisionManager" targetRef="statutRefuse"><conditionExpression xsi:type="tFormalExpression">${decisionManager == 'REFUSER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_decisionManager_statutProvisioning" sourceRef="decisionManager" targetRef="statutProvisioning"/>
    <sequenceFlow id="flow_correction_validationManager" sourceRef="correction" targetRef="validationManager"/>
    <sequenceFlow id="flow_aiguillageIt_validationAcces" sourceRef="aiguillageIt" targetRef="validationAcces"><conditionExpression xsi:type="tFormalExpression">${validationItRequise == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_aiguillageIt_accesDecides" sourceRef="aiguillageIt" targetRef="accesDecides"/>
    <sequenceFlow id="flow_niveauAcces_appelGroupe" sourceRef="niveauAcces" targetRef="appelGroupe"><conditionExpression xsi:type="tFormalExpression">${niveauAcces == 'ETENDU'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_niveauAcces_accesDecides" sourceRef="niveauAcces" targetRef="accesDecides"/>
    <sequenceFlow id="flow_incident_noterIncident" sourceRef="incident" targetRef="noterIncident"/>
    <sequenceFlow id="flow_noterIncident_statutIncident" sourceRef="noterIncident" targetRef="statutIncident"/>
    <sequenceFlow id="flow_statutIncident_traiterIncident" sourceRef="statutIncident" targetRef="traiterIncident"/>
    <sequenceFlow id="flow_traiterIncident_actionIncident" sourceRef="traiterIncident" targetRef="actionIncident"/>
    <sequenceFlow id="flow_statutReprise_reprise" sourceRef="statutReprise" targetRef="reprise"/>
    <sequenceFlow id="flow_actionIncident_statutReprise" sourceRef="actionIncident" targetRef="statutReprise"><conditionExpression xsi:type="tFormalExpression">${actionIncident == 'REESSAYER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_actionIncident_aCompteIam" sourceRef="actionIncident" targetRef="aCompteIam"/>
    <sequenceFlow id="flow_reprise_appelSirh" sourceRef="reprise" targetRef="appelSirh"><conditionExpression xsi:type="tFormalExpression">${etapeEnEchec == 'SIRH'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_reprise_appelIam" sourceRef="reprise" targetRef="appelIam"><conditionExpression xsi:type="tFormalExpression">${etapeEnEchec == 'IAM'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_reprise_appelGroupe" sourceRef="reprise" targetRef="appelGroupe"><conditionExpression xsi:type="tFormalExpression">${etapeEnEchec == 'GROUPE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_reprise_appelTicket" sourceRef="reprise" targetRef="appelTicket"/>
    <sequenceFlow id="flow_aCompteIam_gwCompteIam" sourceRef="aCompteIam" targetRef="gwCompteIam"/>
    <sequenceFlow id="flow_supprimerIam_journalIam" sourceRef="supprimerIam" targetRef="journalIam"/>
    <sequenceFlow id="flow_journalIam_compteIamTraite" sourceRef="journalIam" targetRef="compteIamTraite"/>
    <sequenceFlow id="flow_compteIamTraite_aFicheSirh" sourceRef="compteIamTraite" targetRef="aFicheSirh"/>
    <sequenceFlow id="flow_aFicheSirh_gwFicheSirh" sourceRef="aFicheSirh" targetRef="gwFicheSirh"/>
    <sequenceFlow id="flow_supprimerSirh_journalSirh" sourceRef="supprimerSirh" targetRef="journalSirh"/>
    <sequenceFlow id="flow_journalSirh_ficheSirhTraitee" sourceRef="journalSirh" targetRef="ficheSirhTraitee"/>
    <sequenceFlow id="flow_ficheSirhTraitee_statutAnnule" sourceRef="ficheSirhTraitee" targetRef="statutAnnule"/>
    <sequenceFlow id="flow_statutAnnule_clotureAnnule" sourceRef="statutAnnule" targetRef="clotureAnnule"/>
    <sequenceFlow id="flow_clotureAnnule_finAnnule" sourceRef="clotureAnnule" targetRef="finAnnule"/>
    <sequenceFlow id="flow_gwCompteIam_supprimerIam" sourceRef="gwCompteIam" targetRef="supprimerIam"><conditionExpression xsi:type="tFormalExpression">${compteIamCree == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_gwCompteIam_compteIamTraite" sourceRef="gwCompteIam" targetRef="compteIamTraite"/>
    <sequenceFlow id="flow_gwFicheSirh_supprimerSirh" sourceRef="gwFicheSirh" targetRef="supprimerSirh"><conditionExpression xsi:type="tFormalExpression">${ficheSirhCreee == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="flow_gwFicheSirh_ficheSirhTraitee" sourceRef="gwFicheSirh" targetRef="ficheSirhTraitee"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram_onboardingCollaborateur">
    <bpmndi:BPMNPlane id="plane_onboardingCollaborateur" bpmnElement="onboardingCollaborateur">
      <bpmndi:BPMNShape id="shape_debut" bpmnElement="debut"><omgdc:Bounds x="82" y="222" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_statutValidation" bpmnElement="statutValidation"><omgdc:Bounds x="200" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_validationManager" bpmnElement="validationManager"><omgdc:Bounds x="360" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_decisionManager" bpmnElement="decisionManager"><omgdc:Bounds x="555" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_correction" bpmnElement="correction"><omgdc:Bounds x="520" y="60" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_statutRefuse" bpmnElement="statutRefuse"><omgdc:Bounds x="680" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_clotureRefus" bpmnElement="clotureRefus"><omgdc:Bounds x="840" y="340" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_finRefus" bpmnElement="finRefus"><omgdc:Bounds x="1042" y="362" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_statutProvisioning" bpmnElement="statutProvisioning"><omgdc:Bounds x="680" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_appelSirh" bpmnElement="appelSirh"><omgdc:Bounds x="840" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_controleSirh" bpmnElement="controleSirh"><omgdc:Bounds x="1000" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_resultatSirh" bpmnElement="resultatSirh"><omgdc:Bounds x="1195" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_echecSirh" bpmnElement="echecSirh"><omgdc:Bounds x="1160" y="460" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_enregistrerSirh" bpmnElement="enregistrerSirh"><omgdc:Bounds x="1320" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_appelIam" bpmnElement="appelIam"><omgdc:Bounds x="1480" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_controleIam" bpmnElement="controleIam"><omgdc:Bounds x="1640" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_resultatIam" bpmnElement="resultatIam"><omgdc:Bounds x="1835" y="215" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_echecIam" bpmnElement="echecIam"><omgdc:Bounds x="1800" y="460" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_enregistrerIam" bpmnElement="enregistrerIam"><omgdc:Bounds x="1960" y="200" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_besoinValidationIt" bpmnElement="besoinValidationIt"><omgdc:Bounds x="2120" y="200" width="120" height="80"/></bpmndi:BPMNShape>
