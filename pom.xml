    <profiles>

        <!-- ./mvnw -Pembedded-db package — jar de DÉMO/QA avec PostgreSQL embarqué persistant (zonky).
             Activer ensuite le profil Spring `embedded-db` (voir docs/guides/GETTING-STARTED.md § base embarquée).
             Le jar de production (sans ce profil) ne contient ni zonky ni les binaires PostgreSQL ;
             src/embedded (lanceur) et src/embedded-test (ses tests) ne sont compilés qu'ici. -->
        <profile>
            <id>embedded-db</id>
            <dependencies>
                <dependency>
                    <groupId>io.zonky.test</groupId>
                    <artifactId>embedded-postgres</artifactId>
                    <version>${embedded-postgres.version}</version>
                    <scope>compile</scope>
                </dependency>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>io.zonky.test.postgres</groupId>
                    <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.2</version>
                        <executions>
                            <execution>
                                <id>add-embedded-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/embedded/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-embedded-resources</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>add-resource</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/embedded/resources</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-embedded-test-sources</id>
                                <phase>generate-test-sources</phase>
                                <goals>
                                    <goal>add-test-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/embedded-test/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Même script SQL que docker-compose (docker/postgres/init) : une seule source de
                         vérité pour le schéma tenant et le rôle applicatif. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-embedded-init-sql</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/db/embedded</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>docker/postgres/init</directory>
                                            <includes>
                                                <include>01-init-tenant-schema.sql</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- ./mvnw -Psecurity-scan verify — scan CVE des dépendances (OWASP Dependency-Check).
             Non lié au cycle de vie par défaut : appelle le NVD (réseau + cache local), pas
             adapté à chaque build local/CI standard. -->
        <profile>
            <id>security-scan</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <configuration>
                            <!-- Seuil "High" CVSS (>= 7). Les faux positifs / non-applicables sont
                                 documentés un par un dans dependency-check-suppressions.xml. -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
                            <formats>
                                <format>HTML</format>
                                <format>JSON</format>
                            </formats>
                            <!-- Requise par l'API NVD depuis fin 2023 (sans clé : quota quasi nul,
                                 échec immédiat "Invalid API Key"). Fournie via la variable d'env
                                 NVD_API_KEY (secret GitHub Actions), jamais commitée en clair. -->
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <!-- Sonatype OSS Index (via l'API de compatibilité Sonatype Guide,
                                 https://api.guide.sonatype.com par défaut) : authentification
                                 obligatoire. Username = e-mail du compte (ignoré avec un token Guide),
                                 password = Personal Access Token Guide. Secrets GitHub Actions
                                 OSS_INDEX_USERNAME / OSS_INDEX_TOKEN ; valeurs vides ignorées par le
                                 plugin (analyseur alors désactivé avec un warning, comme avant). -->
                            <ossIndexUsername>${env.OSS_INDEX_USERNAME}</ossIndexUsername>
                            <ossIndexPassword>${env.OSS_INDEX_TOKEN}</ossIndexPassword>
                            <!-- Une panne/limitation d'OSS Index ne doit pas faire échouer le scan :
                                 le NVD reste la source de référence. -->
                            <ossIndexWarnOnlyOnRemoteErrors>true</ossIndexWarnOnlyOnRemoteErrors>
                            <!-- Chemin fixe (par défaut sous ~/.m2) pour pouvoir être mis en cache
                                 entre les runs CI : sans ça, chaque run retélécharge les ~400k
                                 enregistrements NVD depuis zéro (~1h30). -->
                            <dataDirectory>${project.basedir}/dependency-check-data</dataDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- ./mvnw -Pmutation test-compile pitest:mutationCoverage — tests de mutation PIT (TODO §108).
             Hors `verify` : environ 25 min sur 4 cœurs. Workflow .github/workflows/mutation.yml : run complet
             chaque semaine (seuil bloquant), classes modifiées sur les PR (informatif).
             Rapport : target/pit-reports/index.html. -->
        <profile>
            <id>mutation</id>
            <properties>
                <skip.frontend>true</skip.frontend>
                <jacoco.skip>true</jacoco.skip>
                <!-- Périmètre : domaine et adaptateurs testés sans contexte Spring (issue #244). Hors périmètre : web,
                     persistence, flowable, config et signature, testés surtout sous contexte Spring. Une classe
                     @Configuration ne s'y prête pas : le contexte de test mis en cache n'exécute pas ses méthodes @Bean
                     mutées. Une PR restreint la cible avec -Dpit.targetClasses (scripts/mutation-targets.sh lit ce
                     périmètre). -->
                <pit.targetClasses>be.myrmacta.domain.*,be.myrmacta.infrastructure.expression.*,be.myrmacta.infrastructure.connector.*,be.myrmacta.infrastructure.mcp.*,be.myrmacta.infrastructure.security.*,be.myrmacta.infrastructure.notification.*,be.myrmacta.infrastructure.document.*,be.myrmacta.infrastructure.pdf.*,be.myrmacta.infrastructure.storage.*,be.myrmacta.infrastructure.precheck.*,be.myrmacta.infrastructure.assistant.*</pit.targetClasses>
                <!-- Les tests de tout le périmètre : une classe peut n'être tuée que depuis une autre couche
                     (ExpressionLimits, du domaine, par les tests de infrastructure.expression). Même liste que
                     pit.targetClasses, écrite en entier : une PR surcharge les classes, jamais les tests. -->
                <pit.targetTests>be.myrmacta.domain.*,be.myrmacta.infrastructure.expression.*,be.myrmacta.infrastructure.connector.*,be.myrmacta.infrastructure.mcp.*,be.myrmacta.infrastructure.security.*,be.myrmacta.infrastructure.notification.*,be.myrmacta.infrastructure.document.*,be.myrmacta.infrastructure.pdf.*,be.myrmacta.infrastructure.storage.*,be.myrmacta.infrastructure.precheck.*,be.myrmacta.infrastructure.assistant.*</pit.targetTests>
                <!-- Cliquet : score mesuré (79,0 % le 2026-10-27, issue #244) moins 2 points, arrondi par défaut ;
                     à remonter quand le score progresse. -->
                <pit.mutationThreshold>76</pit.mutationThreshold>
                <pit.threads>4</pit.threads>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>${pit.targetClasses}</targetClasses>
                            <targetTests>${pit.targetTests}</targetTests>
                            <!-- Méthodes @Bean jamais réexécutées sous un contexte de test en cache (faux survivants), ou
                                 classe testée seulement sous contexte Spring (AssistantIntegrationTest). -->
                            <excludedClasses>
                                <param>be.myrmacta.infrastructure.security.SecurityConfig*</param>
                                <param>be.myrmacta.infrastructure.security.PortalSecurityConfig*</param>
                                <param>be.myrmacta.infrastructure.assistant.McpDesignToolCatalog*</param>
                            </excludedClasses>
                            <!-- Contexte Spring, base embarquée ou navigateur : lents, et sans effet sur les classes
                                 mutées une fois le contexte en cache. -->
                            <excludedTestClasses>
                                <param>be.myrmacta.domain.dossier.usecase.ConcurrentWorkflowReservationTest</param>
                                <param>be.myrmacta.domain.document.usecase.ResolveDocumentTemplateUseCaseImplTest</param>
                                <param>be.myrmacta.infrastructure.connector.builtin.DocumentStorageCrossDossierIT</param>
                                <param>be.myrmacta.infrastructure.mcp.McpToolCallIntegrationTest</param>
                                <param>be.myrmacta.infrastructure.mcp.McpEndpointApiTest</param>
                                <param>be.myrmacta.infrastructure.mcp.McpServerContextTest</param>
                                <param>be.myrmacta.infrastructure.mcp.McpDirectPublicationIntegrationTest</param>
                                <param>be.myrmacta.infrastructure.security.BffSecurityTest</param>
                                <param>be.myrmacta.infrastructure.security.*ApiTest</param>
                                <param>be.myrmacta.infrastructure.security.WebhookAndCallbackRoutesSecurityTest</param>
                                <param>be.myrmacta.infrastructure.precheck.AiPrecheckIT</param>
                                <param>be.myrmacta.infrastructure.assistant.AssistantIntegrationTest</param>
                            </excludedTestClasses>
                            <threads>${pit.threads}</threads>
                            <mutationThreshold>${pit.mutationThreshold}</mutationThreshold>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Les *IT tournent désormais dans `verify` (PostgreSQL embarqué zonky : plus de
                         dépendance à Docker). Surefire seul, sans plugin Failsafe, comme le reste du dépôt. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- D-44 follow-up: must be a forked-JVM startup property, not a
                         System.setProperty() call in application code — Surefire reuses
                         JVM forks across test classes, and whichever test happens to
                         touch java.net.HttpURLConnection first wins the race otherwise
                         (WebhookRestAdapter's own static initializer is too late once
                         another test class has already loaded it first in the same fork). -->
                    <systemPropertyVariables>
                        <sun.net.http.allowRestrictedHeaders>true</sun.net.http.allowRestrictedHeaders>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <configuration>
                    <rules>
                        <rule>
                            <element>BUNDLE</element>
                            <limits>
                                <limit>
                                    <counter>LINE</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.85</minimum>
                                </limit>
                                <limit>
                                    <counter>BRANCH</counter>
                                    <value>COVEREDRATIO</value>
                                    <minimum>0.75</minimum>
                                </limit>
                            </limits>
                        </rule>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- D-PACK / DD-NODE : build Vite Node 22 → src/main/resources/static/ -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>target</installDirectory>
                    <nodeVersion>v22.14.0</nodeVersion>
                    <skip>${skip.frontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Décision n° 103. LICENSE et NOTICE accompagnent le jar, à META-INF/LICENSE et
                 META-INF/NOTICE. Le repackager Spring Boot ne déplace pas ces entrées sous
                 BOOT-INF/classes (contrairement à META-INF/services/). Contrôle :
                 scripts/check-license-notice-in-jar.sh -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-license-notice</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.frontend}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
