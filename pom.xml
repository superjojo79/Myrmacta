        <dependency>
            <groupId>com.dashjoin</groupId>
            <artifactId>jsonata</artifactId>
            <version>${jsonata.version}</version>
        </dependency>

        <!-- connecteurs-cible (lot B1) — batch-import : parsing .csv robuste (champs cités, virgules
