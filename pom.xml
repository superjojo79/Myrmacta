        <!-- Serveur MCP M2M (serveur-mcp, D-SDK=A) — tool-only, pas de starter chat/model -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Assistant de conception (LC3, D-ASSIST-PROVIDER) — modèle Anthropic via Spring AI, derrière LanguageModelPort ; inactif par défaut -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
            <exclusions>
                <!-- Tiré en 1.9.10 par okio 3.6.0 (via okhttp 4.12.0) : CVE-2026-53914 (9.8) et
                     CVE-2020-29582. Le kotlin-bom ne le gère qu'en type pom (artefact vide depuis
                     Kotlin 1.9.20), donc kotlin.version ne le remonte pas. Le jar 1.9.10 ne
                     contient que des .kotlin_metadata (aucune classe JVM) : exclusion sans effet
                     à l'exécution, kotlin-stdlib fournit tout. -->
                <exclusion>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-stdlib-common</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- connecteurs-cible (lot B1) — kafka : consumer TRIGGER (D-KAFKA-ROLE=A, requirements) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- connecteurs-cible (lot B1) — batch-import : client SFTP (D-SFTP-LIB=SSHJ, design) -->
        <dependency>
            <groupId>com.hierynomus</groupId>
            <artifactId>sshj</artifactId>
            <version>${sshj.version}</version>
        </dependency>

        <!-- connecteurs-cible (lot B1) — batch-import : parsing .xlsx (D-BATCH-FORMAT, requirements) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- LC2 (langage-expression-metier, TODO §75) — JSONata, port Java de référence (Apache 2.0, aucune dépendance
