<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.flowforge</groupId>
    <artifactId>flowforge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Myrmacta</name>
    <description>Myrmacta — L'intelligence collective au service de vos dossiers et décisions</description>

    <!-- Décision n° 103. Identifiant SPDX : PolyForm-Noncommercial-1.0.0. La licence commerciale est un contrat séparé. -->
    <licenses>
        <license>
            <name>PolyForm Noncommercial License 1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
            <distribution>repo</distribution>
            <comments>SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0</comments>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <!-- Décision n° 103. Spring Boot 4.1.1 gère Liquibase 5.0.3, sous FSL-1.1-ALv2.
             4.33.0 est la dernière version dont le texte de licence et le POM sont Apache-2.0.
             Dependabot ignore org.liquibase:* >= 5.0.0 (.github/dependabot.yml). -->
        <liquibase.version>4.33.0</liquibase.version>
        <!-- Décision n° 27 — versions de stack -->
        <flowable.version>8.0.0</flowable.version>
        <flying-saucer.version>10.6.0</flying-saucer.version>
        <jsoup.version>1.23.2</jsoup.version>
        <archunit.version>1.5.1</archunit.version>
        <aws.sdk.version>2.57.2</aws.sdk.version>
        <!-- connecteurs-cible (lot B1) — batch-import : client SFTP + parseur Excel -->
        <sshj.version>0.41.2</sshj.version>
        <!-- LC2 (TODO §75) — JSONata, port Java de référence (Apache 2.0) -->
        <jsonata.version>0.9.10</jsonata.version>
        <poi.version>6.0.0</poi.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <!-- D-SDK=A (serveur-mcp) — Spring AI MCP server WebMVC starter ; D-ASSIST-PROVIDER (revue du 2026-10-02) — starter modèle Anthropic -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <skip.frontend>false</skip.frontend>
        <!-- PostgreSQL embarqué (tests + mode démo/QA) — version majeure alignée sur docker-compose
             (postgres:17-alpine). Les binaires sont fournis par le BOM zonky ci-dessous. -->
        <embedded-postgres.version>2.2.2</embedded-postgres.version>
        <embedded-postgres-binaries.version>17.11.0</embedded-postgres-binaries.version>
        <!-- Override du Tomcat embarqué géré par spring-boot-starter-parent 4.1.1 (fige 11.0.24) :
             11.0.24 porte plusieurs CVE critiques (CVSS 9.8/9.1 — CVE-2026-65905, CVE-2026-65637,
             CVE-2026-68525, CVE-2026-65182 notamment), corrigées à partir de 11.0.25/11.0.26. À
             retirer une fois que Spring Boot gère nativement 11.0.26+ (cf. prochaine version 4.1.x) : issue #195. -->
        <tomcat.version>11.0.26</tomcat.version>
        <!-- Override du Kotlin géré par spring-boot-starter-parent 4.1.1 (fige 2.3.21) : stdlib
             < 2.4.20 porte CVE-2026-53914 (CVSS 9.8, désérialisation non sûre). Kotlin n'arrive
             que transitivement (anthropic-java-core via spring-ai-anthropic) ; la stdlib reste
             rétrocompatible binairement. À retirer quand Spring Boot gère nativement 2.4.20+ : issue #196. -->
        <kotlin.version>2.4.20</kotlin.version>
        <!-- Override du Netty géré par spring-boot-starter-parent 4.1.1 (fige 4.2.17.Final) :
             CVE-2026-89044 (request smuggling, Transfer-Encoding mal validé), corrigée en
             4.2.18.Final. Netty n'arrive que via le client HTTP async du SDK AWS (netty-nio-client).
             À retirer quand Spring Boot gère nativement 4.2.18+ : issue #197. -->
        <netty.version>4.2.19.Final</netty.version>
        <!-- Override du webjar swagger-ui tiré par springdoc 3.1.1 (5.32.14) : le DOMPurify 3.4.13
             embarqué porte CVE-2026-109344 / CVE-2026-109345 (XSS en mode IN_PLACE), corrigées
             en DOMPurify 3.4.16, embarqué à partir de swagger-ui 5.34.0. springdoc résout le
             chemin du webjar dynamiquement (webjars-locator-lite). À retirer quand springdoc
             tire nativement 5.34.0+ : issue #198. -->
        <swagger-ui.version>5.34.0</swagger-ui.version>
    </properties>

