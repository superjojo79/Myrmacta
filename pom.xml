        <!-- Assistant de conception (LC3, D-ASSIST-PROVIDER) — modèle Anthropic via Spring AI, derrière LanguageModelPort ; inactif par défaut -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
            <exclusions>
