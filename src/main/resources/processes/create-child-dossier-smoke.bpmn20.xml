<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowforge/processes">
  <process id="createChildDossierSmoke" name="Create Child Dossier Smoke" isExecutable="true">
    <startEvent id="startEvent" name="Start" />
    <sequenceFlow id="flow_start_create" sourceRef="startEvent" targetRef="createChild" />
    <serviceTask id="createChild"
                 name="Create child dossier"
                 flowable:delegateExpression="${createChildDossierTask}" />
    <sequenceFlow id="flow_create_end" sourceRef="createChild" targetRef="endEvent" />
    <endEvent id="endEvent" name="End" />
  </process>
</definitions>
