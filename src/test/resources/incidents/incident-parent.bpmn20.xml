<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowforge/test">

  <!-- TODO §94 (revue M2) : l'échec d'un sous-process appelé doit se voir sur l'étape d'appel du process parent. -->
  <process id="incidentParent" name="Incident Parent" isExecutable="true">
    <startEvent id="ipStart"/>
    <sequenceFlow id="ipFlow1" sourceRef="ipStart" targetRef="ipCall"/>
    <callActivity id="ipCall" name="Appel du sous-process" calledElement="incidentSmoke"/>
    <sequenceFlow id="ipFlow2" sourceRef="ipCall" targetRef="ipDone"/>
    <userTask id="ipDone" name="Fin parent" flowable:assignee="incident-smoke"/>
  </process>
</definitions>
