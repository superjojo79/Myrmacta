<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://myrmacta/test">

  <!--
    TODO §155 (lot 2) : « Envoyer en eBox » sur le moteur réel, vers un citoyen (voie citoyen simulée, sans consentement par
    défaut). Synchrone ici pour que le test lise l'issue sans attendre l'exécuteur ; la palette et le déploiement Myrmacta
    l'exigent asynchrone. L'instance de connecteur est remplacée par le test (__INSTANCE__).
  -->
  <process id="eboxSend" name="Envoi eBox" isExecutable="true">
    <startEvent id="esStart"/>
    <sequenceFlow id="esFlow1" sourceRef="esStart" targetRef="esWait"/>
    <userTask id="esWait" name="Attente" flowable:assignee="ebox-smoke"/>
    <sequenceFlow id="esFlow2" sourceRef="esWait" targetRef="esAttach"/>
    <serviceTask id="esAttach" name="Joindre la décision" flowable:delegateExpression="${attachGeneratedDocumentTask}"/>
    <sequenceFlow id="esFlow3" sourceRef="esAttach" targetRef="esSend"/>
    <serviceTask id="esSend" name="Envoyer en eBox"
                 flowable:delegateExpression="${eboxSendTask}"
                 flowable:connectorInstanceId="__INSTANCE__"
                 flowable:eboxEnvoiTypeDestinataire="CITOYEN"
                 flowable:eboxEnvoiDestinataire="dossierField:niss"
                 flowable:eboxEnvoiDocument="variable:generatedDocumentId"
                 flowable:eboxEnvoiObjet="Votre permis"
                 flowable:eboxEnvoiApplication="myrmacta-commune"
                 flowable:eboxEnvoiTypeMessage="decision"
                 flowable:eboxEnvoiLangue="dossierField:langue"
                 flowable:eboxEnvoiSecours="EMAIL"/>
    <sequenceFlow id="esFlow4" sourceRef="esSend" targetRef="esGateway"/>
    <exclusiveGateway id="esGateway" default="esFlowDone"/>
    <sequenceFlow id="esFlowFallback" sourceRef="esGateway" targetRef="esFallback">
      <conditionExpression>${eboxSecoursRequis == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="esFlowDone" sourceRef="esGateway" targetRef="esDone"/>
    <userTask id="esFallback" name="Envoyer par la voie de secours" flowable:assignee="ebox-smoke"/>
    <userTask id="esDone" name="Terminé" flowable:assignee="ebox-smoke"/>
  </process>
</definitions>
